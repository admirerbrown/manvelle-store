# Copy to .env.cloud and fill in. Add .env.cloud to .gitignore. Never commit it.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=the-database-password-you-chose
# Optional for catalog sync; use a server-side service_role or sb_secret key.
# Do not use the anon/publishable key here. If omitted, the key is fetched using your Supabase CLI login.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAILS=admin1@example.com,admin2@example.com
SMTP_PASS=your-smtp-provider-api-key-or-password
